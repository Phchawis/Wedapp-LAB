# ════════════════════════════════════════════════════════════════
# TUH Lab QMS — ตัวอย่าง .env สำหรับรันบน VPS
# คัดลอกเป็น .env แล้วเติมค่าจริง:  cp .env.vps.example .env
# ════════════════════════════════════════════════════════════════

# ── ฐานข้อมูล ─────────────────────────────────────────────────
# ใช้ Postgres container เดิมของ Masterlist แต่แยกเป็น database ชื่อ labqms
# host คือ "db" (ชื่อ service ใน compose ของ Masterlist)
# แทน <รหัสผ่าน> ด้วยรหัสของ user labqms ที่สร้างไว้ (ดู DEPLOY-VPS.md ขั้นที่ 2)
DATABASE_URL=postgres://labqms:<รหัสผ่าน>@db:5432/labqms

# ── ความปลอดภัย ──────────────────────────────────────────────
# สร้างด้วย:  openssl rand -base64 32
JWT_SECRET=

# ⚠️ ต้องเหมือนกับ SSO_SHARED_SECRET ของระบบ Masterlist เป๊ะ ๆ
# ดูค่าเดิมได้จาก .env ของ Masterlist บน VPS
SSO_SHARED_SECRET=

# ── เครือข่าย docker ของ Masterlist ──────────────────────────
# ตรวจชื่อจริงด้วย:  docker network ls | grep -i masterlist
MASTERLIST_NETWORK=masterlist_default
